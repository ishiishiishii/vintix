# autopilot settings (sourced by autopilot.sh). Secrets go in /workspace/.env, not here.

# Hours between checks (autopilot.sh on <hours> overrides and remembers it).
# Each check is a cheap script; the AI is called only when something changed.
INTERVAL_HOURS=8
# Never call the AI more than this many times per day, even if things keep changing.
MAX_AI_TICKS_PER_DAY=3
# Turn autopilot off after this many consecutive checks with no change at all (8h x 3 = 24h).
AUTO_OFF_IDLE_CHECKS=3
# Turn autopilot off when the AI reports "waiting on the user" this many times in a row.
AUTO_OFF_WAITING_TICKS=2
# GitHub issue that gets a comment when autopilot turns itself off (research workflow issue).
NOTIFY_ISSUE=6
# An AI tick that runs longer than this is killed.
TICK_TIMEOUT_MIN=60
# A new experiment may be launched without asking only if its estimated GPU time is at most this.
MAX_NEW_GPU_HOURS=12
# Optional model override for the headless agent (empty = CLI default).
AGENT_MODEL=
